# Copy to .env and fill in. The .env file is not committed to git.

# --- PostgreSQL ---
POSTGRES_USER=cryptohub
POSTGRES_PASSWORD=cryptohub
POSTGRES_DB=cryptohub
# Locally (without docker) this is localhost. docker-compose substitutes db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Web panel ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Port the panel is published on, on the host. Inside the container it is
# always 8000; change it here if 8000 is already taken on the machine.
WEB_PUBLIC_PORT=8000
# Signing secret for the session cookie. The value below is a placeholder:
# until it is replaced, the app refuses to start (except with DEBUG=true).
# Otherwise anyone with the source code could forge a cookie signed with a
# known secret. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-secret-change-me
# Secure flag on the session cookie. In production (https) - true. To run over
# plain http set it to false, otherwise the browser won't send the cookie and
# login won't work.
SESSION_SECURE_COOKIE=true
# Public address of the panel - used by the bot for links.
PUBLIC_URL=http://localhost:8000
# Domain for the production deployment: Caddy obtains a certificate for it. Not
# needed locally.
DOMAIN=
# Detailed FastAPI tracebacks. Keep false in production: responses must not
# expose application internals.
DEBUG=false

# --- Encryption of exchange API keys ---
# Fernet key. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: if this key is lost, stored exchange keys cannot be decrypted and have to be
# added again. Store it separately from database backups.
ENCRYPTION_KEY=

# --- First account (owner) ---
# Created on first start. Everyone else registers with an invite that the owner
# issues from the admin panel.
SEED_OWNER_EMAIL=owner@example.com
# Also a placeholder: the app won't start with the example value.
SEED_OWNER_PASSWORD=change-me

# --- Telegram bot ---
# Token from @BotFather. Empty - the bot simply doesn't start; the web panel
# works without it.
BOT_TOKEN=

# --- Web push ---
# VAPID key pair: the browser's push service uses it to tell our server apart
# from anyone else's. Generate one:
#   docker compose run --rm web python -m app.services.webpush
# Empty - web push is disabled; the feed and Telegram work as usual.
# Browsers only allow push over https (and on localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service - required by the spec, mailto: or https:.
VAPID_SUBJECT=mailto:admin@example.com

# --- External data sources ---
# CoinGecko: without a key the public tier works with a strict request limit. A
# Demo key is free and raises the limit. The Fear & Greed index
# (alternative.me) needs no key at all.
COINGECKO_API_KEY=

# --- P2P ---
# Global kill switch. When off, rules can be configured and run in observe
# mode, but the bot doesn't touch the ad price.
# P2P endpoints are only available to accounts with advertiser status (Bybit)
# or verified merchant status (Binance).
P2P_ENABLED=false
SYNC_P2P_ADS_INTERVAL=300
REPRICE_P2P_INTERVAL=60

# --- Data retention ---
# Cleanup runs once a day. Candles are capped by count, not age: a week
# produces ten thousand one-minute candles but only seven daily ones, so a
# single age limit would mean either junk or an empty chart.
CANDLES_KEEP_PER_SERIES=1500
# Zero in any of the three means never delete.
LOGIN_EVENTS_KEEP_DAYS=180
NOTIFICATIONS_KEEP_DAYS=90
GLOBAL_STATS_KEEP_DAYS=365
P2P_EVENTS_KEEP_DAYS=180

# --- Background job intervals, seconds ---
SYNC_BALANCES_INTERVAL=60
SYNC_TRADES_INTERVAL=300
SYNC_TICKERS_INTERVAL=60
POLL_CANDLES_INTERVAL=30
EVALUATE_ALERTS_INTERVAL=15
EVALUATE_SIGNALS_INTERVAL=60
PORTFOLIO_SNAPSHOT_INTERVAL=900
GLOBAL_STATS_INTERVAL=300

# --- Auto-trading ---
# Global kill switch. Even with true, every strategy starts in paper mode, and
# live trading is enabled by a separate confirmation in the UI.
AUTOTRADE_ENABLED=false
