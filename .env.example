# Скопировать в .env и заполнить. Файл .env в git не попадает.

# --- PostgreSQL ---
POSTGRES_USER=cryptohub
POSTGRES_PASSWORD=cryptohub
POSTGRES_DB=cryptohub
# Локально (без docker) — localhost. В docker-compose подставляется db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Веб-панель ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Порт, на котором панель публикуется на хосте. Внутри контейнера всегда
# 8000; менять здесь, если 8000 на машине уже занят.
WEB_PUBLIC_PORT=8000
# Секрет подписи сессионной cookie. Значение ниже — заглушка: пока она не
# заменена, приложение откажется стартовать (кроме DEBUG=true). Иначе
# подписанную известным секретом cookie подделает любой, у кого есть
# исходники. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-secret-change-me
# Флаг Secure у сессионной cookie. На проде (https) — true. Для запуска
# по обычному http поставить false, иначе браузер не отправит cookie и
# вход не сработает.
SESSION_SECURE_COOKIE=true
# Публичный адрес панели — используется ботом для ссылок.
PUBLIC_URL=http://localhost:8000
# Домен для прод-развёртывания: под него Caddy получает сертификат.
# Локально не нужен.
DOMAIN=
# Подробные трассировки FastAPI. На проде оставить false: в ответах
# не должно быть внутренностей приложения.
DEBUG=false

# --- Шифрование API-ключей бирж ---
# Fernet-ключ. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: при потере ключа сохранённые ключи бирж расшифровать нельзя,
# их придётся заводить заново. Хранить отдельно от бэкапа базы.
ENCRYPTION_KEY=

# --- Первый аккаунт (владелец) ---
# Создаётся при первом запуске. Остальные регистрируются по инвайту,
# который владелец выдаёт из админки.
SEED_OWNER_EMAIL=owner@example.com
# Тоже заглушка: со значением из примера приложение не стартует.
SEED_OWNER_PASSWORD=change-me

# --- Telegram-бот ---
# Токен от @BotFather. Пусто — бот просто не запускается,
# веб-панель работает без него.
BOT_TOKEN=

# --- Веб-пуш ---
# Пара ключей VAPID: ими push-сервис браузера отличает наш сервер от
# чужого. Сгенерировать:
#   docker compose run --rm web python -m app.services.webpush
# Пусто — веб-пуш выключен, лента и Telegram работают как обычно.
# Браузер разрешает пуш только на https (и на localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервиса — требование спецификации, mailto: или https:.
VAPID_SUBJECT=mailto:admin@example.com

# --- Внешние источники данных ---
# CoinGecko: без ключа работает публичный тир с жёстким лимитом запросов.
# Demo-ключ бесплатный и лимит поднимает. Индекс страха и жадности
# (alternative.me) ключа не требует вообще.
COINGECKO_API_KEY=

# --- P2P ---
# Глобальный рубильник. Выключен — правила настраиваются и работают в
# режиме наблюдения, но цену объявления бот не трогает.
# Доступ к P2P-эндпоинтам открыт только аккаунтам со статусом
# рекламодателя (Bybit) или верифицированного мерчанта (Binance).
P2P_ENABLED=false
SYNC_P2P_ADS_INTERVAL=300
REPRICE_P2P_INTERVAL=60

# --- Хранение данных ---
# Уборка идёт раз в сутки. Свечи ограничиваются количеством, а не
# возрастом: минутных за неделю набегает десять тысяч, а дневных семь, и
# общий срок означал бы либо мусор, либо пустой график.
CANDLES_KEEP_PER_SERIES=1500
# Ноль в любом из трёх — не удалять вовсе.
LOGIN_EVENTS_KEEP_DAYS=180
NOTIFICATIONS_KEEP_DAYS=90
GLOBAL_STATS_KEEP_DAYS=365

# --- Интервалы фоновых задач, секунды ---
SYNC_BALANCES_INTERVAL=60
SYNC_TRADES_INTERVAL=300
SYNC_TICKERS_INTERVAL=60
POLL_CANDLES_INTERVAL=30
EVALUATE_ALERTS_INTERVAL=15
EVALUATE_SIGNALS_INTERVAL=60
PORTFOLIO_SNAPSHOT_INTERVAL=900
GLOBAL_STATS_INTERVAL=300

# --- Автотрейдинг ---
# Глобальный рубильник. Даже при true каждая стратегия стартует в режиме
# paper, а реальные сделки включаются отдельным подтверждением в интерфейсе.
AUTOTRADE_ENABLED=false
