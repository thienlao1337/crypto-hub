# Reverse proxy with automatic HTTPS.
#
# Caddy obtains and renews the Let's Encrypt certificate for the domain in the
# DOMAIN variable by itself - no separate certbot or scheduled jobs needed.

{$DOMAIN} {
	encode zstd gzip

	# The WebSocket for the order book and trade feed goes through the same route:
 # Caddy forwards Upgrade headers without extra configuration.
	reverse_proxy web:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		# The panel must not be embedded in third-party frames and must not sniff
  # content types.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# HSTS is enabled only once the domain is already served over https,
  # otherwise falling back to http becomes impossible.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format console
	}
}
